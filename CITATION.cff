  "preferred-citation": {
    "type": "thesis",
    "title": "Modelling and worldwide assessment of performance and aging of photovoltaic modules and systems",
    "authors": [
      {
        "family-names": "Ascencio Vásquez",
        "given-names": "Julián Andrés"
      }
    ],
    "url": "https://www.dlib.si/details/URN:NBN:SI:DOC-TMG3QFI9",
    "notes": "Role: primary. Primary scientific reference for this repository. University of Ljubljana catalogue: COBISS 77808131; national-library URN:NBN:SI:DOC-TMG3QFI9. Defended 21 September 2021. Marko Topič is the advisor, not a coauthor. No thesis DOI has been verified. Citation does not claim that every thesis chapter is implemented. CCYA implementation follows sections 7.5.1–7.5.3 (pp. 150–164), with equations 3.6/3.8 for thermal context. The institutional full text is https://repozitorij.uni-lj.si/Dokument.php?id=148326&lang=eng. Explicit choices for monthly centroid scaling, incremental temperature normalization, nonexceedance quantiles and cumulative ratio versus signed gain are documented in docs/ccya.md; no numerical reproduction of Bolzano is claimed. Soiling and snow indicators follow Eqs. 3.2–3.4 (pp. 49–51) and Tables 6.6–6.7 (pp. 135–136), with explicit equality/low-domain conventions and alternative example data documented in docs/soiling-snow.md.",
    "year": 2021,
    "institution": {
      "name": "University of Ljubljana, Faculty of Electrical Engineering"
    },
    "thesis-type": "Doctoral dissertation"
  },
