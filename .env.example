# Export these variables in your shell or job runner. The CLI does not
# automatically load .env files. Never commit a populated local .env file.

# Required for authenticated CEN generation requests.
CEN_USER_KEY=

# Required for AEMET OpenData acquisitions. Obtain your own key from AEMET.
# A verified saved AEMET snapshot can be reused without a network request.
AEMET_API_KEY=

# Required for EIA API v2 generation. Public EIA-930 balance files need no key.
EIA_API_KEY=

# Required for ENTSO-E Transparency Platform REST API access.
ENTSOE_API_TOKEN=

# Optional: use your licensed Open-Meteo customer access when applicable.
OPEN_METEO_API_KEY=
