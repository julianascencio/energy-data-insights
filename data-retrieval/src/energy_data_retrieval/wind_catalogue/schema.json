{
  "version": "1.0.0",
  "entity_types": [
    "projects",
    "equipment",
    "turbines",
    "curves"
  ],
  "required": [
    "record_id",
    "entity_type",
    "name",
    "record_scope",
    "capacity_scope",
    "created_at",
    "updated_at",
    "last_verified_at",
    "sources",
    "field_sources_json",
    "evidence_json",
    "quality_status"
  ],
  "fields": {
    "record_id": {
      "type": "string",
      "description": "Stable UUID; retain through renames and changes in capacity."
    },
    "name": {
      "type": "string",
      "description": "Identifiable facility, phase or exact equipment name."
    },
    "capacity_scope": {
      "type": "string",
      "description": "Physical boundary and configuration covered by reported ratings."
    },
    "notes": {
      "type": "string",
      "description": "Review notes; no unsupported technical facts."
    },
    "country_code": {
      "type": "string",
      "description": "ISO alpha-3 country code."
    },
    "region": {
      "type": "string",
      "description": "Reported administrative region."
    },
    "locality": {
      "type": "string",
      "description": "Reported municipality/locality."
    },
    "location_accuracy": {
      "type": "string",
      "description": "Precision and method of public coordinates."
    },
    "phase_id": {
      "type": "string",
      "description": "Separately documented development phase identifier."
    },
    "parent_record_id": {
      "type": "string",
      "description": "Optional parent project UUID in this catalogue."
    },
    "overlap_group": {
      "type": "string",
      "description": "Stable group for overlapping capacity observations."
    },
    "manufacturer": {
      "type": "string",
      "description": "OEM, not distributor or integrator unless explicitly identified as manufacturer."
    },
    "model": {
      "type": "string",
      "description": "Exact OEM model designation."
    },
    "variant": {
      "type": "string",
      "description": "Explicit documented configuration; never synthesized combinations."
    },
    "product_status": {
      "type": "string",
      "description": "Dated OEM lifecycle claim; availability is not assumed."
    },
    "official_url": {
      "type": "string",
      "description": "Official project or product page."
    },
    "grid_utility": {
      "type": "string",
      "description": "Reported electrical utility."
    },
    "status_date_basis": {
      "type": "string",
      "description": "Publication date or dated retrieval of undated evidence."
    },
    "entity_type": {
      "type": "string",
      "description": "Connected catalogue table.",
      "enum": [
        "projects",
        "equipment",
        "turbines",
        "curves"
      ]
    },
    "record_scope": {
      "type": "string",
      "description": "Physical identity granularity.",
      "enum": [
        "farm",
        "phase",
        "group",
        "repowering_generation",
        "model",
        "configuration",
        "turbine",
        "curve"
      ]
    },
    "aggregation_role": {
      "type": "string",
      "description": "Only independent or child records can contribute to sums. Aggregate and unresolved scopes are excluded even if filtered children are absent.",
      "enum": [
        "independent",
        "child",
        "aggregate",
        "unresolved"
      ]
    },
    "status": {
      "type": "string",
      "description": "Last evidenced project lifecycle; a portfolio listing alone does not establish operation.",
      "enum": [
        "announced",
        "permitted",
        "under_construction",
        "commissioning",
        "operational",
        "partially_operational",
        "repowering",
        "suspended",
        "cancelled",
        "decommissioned",
        "unknown"
      ]
    },
    "equipment_category": {
      "type": "string",
      "description": "Exact equipment category.",
      "enum": [
        "wind_turbine",
        "blade",
        "rotor",
        "gearbox",
        "generator",
        "converter",
        "tower",
        "foundation",
        "floating_platform",
        "transformer",
        "switchgear",
        "control"
      ]
    },
    "quality_status": {
      "type": "string",
      "description": "Evidence qualification; does not certify a facility or product.",
      "enum": [
        "source_backed",
        "needs_review"
      ]
    },
    "created_at": {
      "type": "timestamp",
      "description": "UTC timestamp; updated_at changes only on substantive data/evidence changes."
    },
    "updated_at": {
      "type": "timestamp",
      "description": "UTC timestamp; updated_at changes only on substantive data/evidence changes."
    },
    "last_verified_at": {
      "type": "timestamp",
      "description": "UTC timestamp; updated_at changes only on substantive data/evidence changes."
    },
    "status_as_of": {
      "type": "string",
      "description": "ISO date; only precise reported dates, never a forecast treated as achieved.",
      "format": "date"
    },
    "announcement_date": {
      "type": "string",
      "description": "ISO date; only precise reported dates, never a forecast treated as achieved.",
      "format": "date"
    },
    "construction_date": {
      "type": "string",
